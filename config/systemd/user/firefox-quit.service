[Unit]
Description=Gracefully quit Firefox before shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/bash -c 'pid=$(pgrep -o -x firefox-bin) && kill -TERM "$pid" && timeout 10 tail --pid="$pid" -f /dev/null || true'
TimeoutStopSec=15

[Install]
WantedBy=default.target
