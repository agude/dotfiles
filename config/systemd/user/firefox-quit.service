[Unit]
Description=Gracefully quit Firefox before shutdown
After=graphical-session.target

[Service]
ExecStart=/bin/bash -c 'gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 | while read -r line; do case "$line" in *PrepareForShutdown*"true"*) pid=$(pgrep -o -x firefox-bin) && kill -TERM "$pid" && timeout 10 tail --pid="$pid" -f /dev/null; exit 0;; esac; done'
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
