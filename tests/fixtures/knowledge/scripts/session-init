#!/usr/bin/env bash

set -eu

session_id=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --session-id)
            session_id="$2"
            shift 2
            ;;
        *)
            exit 2
            ;;
    esac
done

[[ -n "$session_id" ]] || exit 2

session_directory="${SESSION_DIR:-${TMPDIR:-/tmp}/knowledge-sessions-$(id -u)}"
session_file="${session_directory}/session-${session_id}.jsonl"
mkdir -p "$session_directory"
: > "$session_file"
printf '%s\n' "$session_file"
