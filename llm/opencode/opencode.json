{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "webfetch": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",

      "* --help": "allow",
      "* --version": "allow",

      "ack *": "allow",
      "ag *": "allow",
      "apt list *": "allow",
      "awk *": "allow",
      "cat *": "allow",
      "cmp *": "allow",
      "column *": "allow",
      "command -v *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "egrep *": "allow",
      "env": "allow",
      "fgrep *": "allow",
      "file *": "allow",
      "find *": "allow",
      "fzf *": "allow",
      "grep *": "allow",
      "gsutil ls *": "allow",
      "head *": "allow",
      "hermit env *": "allow",
      "hermit list *": "allow",
      "hermit search *": "allow",
      "hermit status *": "allow",
      "hermit version *": "allow",
      "hostname": "allow",
      "htop *": "allow",
      "id *": "allow",
      "jobs": "allow",
      "just *": "allow",
      "less *": "allow",
      "locate *": "allow",
      "ls *": "allow",
      "man *": "allow",
      "more *": "allow",
      "nl *": "allow",
      "npm list *": "allow",
      "npm outdated": "allow",
      "npm view *": "allow",
      "pgrep *": "allow",
      "pip list *": "allow",
      "printf *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "ruff check": "allow",
      "ruff config": "allow",
      "ruff linter": "allow",
      "ruff rule *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "top *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "type *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "uptime": "allow",
      "uv pip check *": "allow",
      "uv pip list *": "allow",
      "uv pip show *": "allow",
      "uv pip tree *": "allow",
      "uv python list": "allow",
      "uv tool list": "allow",
      "wc *": "allow",
      "whereis *": "allow",
      "which *": "allow",
      "whoami": "allow",

      "git add *": "allow",
      "git annotate *": "allow",
      "git blame *": "allow",
      "git branch": "allow",
      "git cat-file *": "allow",
      "git config --get *": "allow",
      "git config --list": "allow",
      "git describe *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git ls-remote *": "allow",
      "git ls-tree *": "allow",
      "git reflog *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git shortlog *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git stash show *": "allow",
      "git stash *": "allow",
      "git status": "allow",
      "git submodule status": "allow",
      "git tag": "allow",
      "git whatchanged *": "allow",

      "dd *": "deny",
      "fdisk *": "deny",
      "gh repo archive *": "deny",
      "gh repo change-visibility *": "deny",
      "gh repo delete *": "deny",
      "gh repo rename *": "deny",
      "gh auth *": "deny",
      "gh ssh-key *": "deny",
      "gh gpg-key *": "deny",
      "gh issue delete *": "deny",
      "git commit --no-verify *": "deny",
      "git commit -n *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git -C *": "deny",
      "git clone *": "deny",
      "git fetch *": "deny",
      "git pull *": "deny",
      "halt": "deny",
      "hermit clean *": "deny",
      "hermit uninstall *": "deny",
      "insmod *": "deny",
      "mkfs *": "deny",
      "modprobe *": "deny",
      "parted *": "deny",
      "poweroff": "deny",
      "reboot": "deny",
      "shutdown *": "deny",
      "su *": "deny",
      "sudo *": "deny",
      "systemctl disable *": "deny",
      "systemctl enable *": "deny",
      "systemctl restart *": "deny",
      "systemctl start *": "deny",
      "systemctl stop *": "deny",
      "uv cache clean *": "deny",
      "uv pip uninstall *": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "qwen2.5-coder:7b-32k": {
          "name": "Qwen 2.5 Coder 7B (32k ctx)"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        },
        "qwen3:8b-32k": {
          "name": "Qwen 3 8B (32k ctx)"
        },
        "qwen3.5:9b-32k": {
          "name": "Qwen 3.5 9B (32k ctx)"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B"
        }
      }
    }
  }
}
