{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "webfetch": "ask",
    "external_directory": {
      "/tmp/**": "allow",
      "~/Projects/**": "allow",
      "~/Knowledge/**": "allow",
      "~/Wiki/**": "allow",
      "~/.dotfiles/**": "allow"
    },
    "bash": {
      "*": "allow",
      "chmod *": "ask",
      "chown *": "ask",
      "gh pr merge *": "ask",
      "git clean *": "ask",
      "git reset --hard *": "ask",
      "rm *": "ask",
      "bash": "deny",
      "sh": "deny",
      "zsh": "deny",
      "chmod -R *": "deny",
      "chown -R *": "deny",
      "dd *": "deny",
      "fdisk *": "deny",
      "gh auth *": "deny",
      "gh gpg-key *": "deny",
      "gh issue delete *": "deny",
      "gh repo archive *": "deny",
      "gh repo change-visibility *": "deny",
      "gh repo delete *": "deny",
      "gh repo rename *": "deny",
      "gh ssh-key *": "deny",
      "git -C *": "deny",
      "git clone *": "deny",
      "git commit --no-verify *": "deny",
      "git commit -n *": "deny",
      "git fetch *": "deny",
      "git pull *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "halt": "deny",
      "hermit clean *": "deny",
      "hermit uninstall *": "deny",
      "insmod *": "deny",
      "mkfs *": "deny",
      "modprobe *": "deny",
      "parted *": "deny",
      "poweroff": "deny",
      "reboot": "deny",
      "rm -Rf *": "deny",
      "rm -fr *": "deny",
      "rm -rf *": "deny",
      "shutdown *": "deny",
      "su": "deny",
      "su *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "systemctl disable *": "deny",
      "systemctl enable *": "deny",
      "systemctl restart *": "deny",
      "systemctl start *": "deny",
      "systemctl stop *": "deny",
      "uv cache clean *": "deny",
      "uv pip uninstall *": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "qwen2.5-coder:7b-32k": {
          "name": "Qwen 2.5 Coder 7B (32k ctx)"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        },
        "qwen3:8b-32k": {
          "name": "Qwen 3 8B (32k ctx)"
        },
        "qwen3.5:9b-32k": {
          "name": "Qwen 3.5 9B (32k ctx)"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B"
        }
      }
    }
  }
}
