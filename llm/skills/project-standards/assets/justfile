# Task runner for PACKAGE. Quality checks are read-only and locked; deliberate
# dependency changes use `just lock` or `just deps-update`.

set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

lock:
    uv lock

sync:
    uv sync --locked --dev

deps-update PACKAGE="":
    #!/usr/bin/env bash
    if [[ -n "{{ PACKAGE }}" ]]; then
        uv lock --upgrade-package "{{ PACKAGE }}"
    else
        uv lock --upgrade
    fi

lint: lint-workflows
    uv run --locked ruff check .
    uv run --locked ruff format --check .

lint-workflows:
    #!/usr/bin/env bash
    if command -v actionlint >/dev/null 2>&1; then
        actionlint
    else
        echo "lint-workflows: actionlint is required; install it before linting workflows" >&2
        exit 1
    fi
    if command -v zizmor >/dev/null 2>&1; then
        zizmor --pedantic .github/workflows
    else
        echo "lint-workflows: zizmor is required; install it before linting workflows" >&2
        exit 1
    fi

format:
    uv run --locked ruff format .
    uv run --locked ruff check --fix .

type-check:
    uv run --locked mypy src/PACKAGE/ tests/

test *args:
    uv run --locked pytest -vv {{ args }}

build:
    rm -rf dist/
    uv build --out-dir dist

package-check ARTIFACTS="":
    #!/usr/bin/env bash
    package_args=(--import PACKAGE --distribution REPO --license LICENSE.md --typed)
    if [[ -n "PROJECT_COMMAND_NAME" ]]; then
        package_args+=(--command "PROJECT_COMMAND_NAME")
    fi
    if [[ -n "{{ ARTIFACTS }}" ]]; then
        package_args+=(--artifacts "{{ ARTIFACTS }}")
    fi
    bash scripts/package-check.sh "${package_args[@]}"

check: lint type-check test package-check

release *ARGS:
    bash scripts/release.sh {{ ARGS }}

clean:
    rm -rf dist/ build/ *.egg-info .pytest_cache .ruff_cache .mypy_cache .venv

hooks-install:
    bash scripts/hooks-install.sh
